{
  "name": "pt-smm-digital-automation-dashboard",
  "version": "2.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:backend": "tsc -p tsconfig.backend.json",
    "dev:postgres": "npm run build:backend && npm run start:postgres",
    "start:postgres": "node --env-file=.env dist-backend/server/nest/main.js",
    "user:create": "node --env-file=.env scripts/create-dashboard-user.mjs",
    "seed:kalender-batch": "node --env-file=.env scripts/inject-kalender-batch-tracking.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}
